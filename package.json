{
  "name": "nag",
  "version": "0.1.0",
  "description": "AI 잔소리 분석기 — GitHub 커밋 수집기",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.app.json",
    "dev": "vite",
    "preview": "vite preview",
    "fetch-commits": "tsx scripts/fetch-commits.ts",
    "test-analyzer": "tsx scripts/test-analyzer.ts",
    "generate-mock-report": "tsx scripts/generate-mock-report.ts"
  },
  "keywords": ["github", "commits", "ai-nag"],
  "license": "MIT",
  "dependencies": {
    "@octokit/plugin-throttling": "^9.3.2",
    "@octokit/request-error": "^6.1.7",
    "@octokit/rest": "^21.0.2",
    "dotenv": "^16.4.7",
    "p-limit": "^6.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.2.0"
  }
}
